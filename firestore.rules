rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMovieGroupMember(groupId) {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/movieGroups/$(groupId)/members/$(request.auth.uid)
        );
    }

    function areAcceptedFriends(firstUid, secondUid) {
      let forwardRequest = /databases/$(database)/documents/friendRequests/$(firstUid + '_' + secondUid);
      let reverseRequest = /databases/$(database)/documents/friendRequests/$(secondUid + '_' + firstUid);
      return (exists(forwardRequest) && get(forwardRequest).data.status == 'accepted')
        || (exists(reverseRequest) && get(reverseRequest).data.status == 'accepted');
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'username',
          'usernameLower',
          'displayName',
          'photoURL'
        ])
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.usernameLower == request.resource.data.username
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.username)
        ).data.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL']);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/userProfiles/$(request.auth.uid)
        ).data.username == username;
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      allow get: if request.auth != null
        && (resource == null
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow list: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'status'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        && !exists(
          /databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.resource.data.fromUid)
        );
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }

    match /movieGroups/{groupId} {
      allow read: if isMovieGroupMember(groupId);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && getAfter(
          /databases/$(database)/documents/movieGroups/$(groupId)/members/$(request.auth.uid)
        ).data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && isMovieGroupMember(groupId);

      match /members/{memberUid} {
        allow get: if request.auth != null
          && (isMovieGroupMember(groupId)
            || resource.data.uid == request.auth.uid);
        allow list: if request.auth != null
          && (isMovieGroupMember(groupId)
            || resource.data.uid == request.auth.uid);
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly([
            'uid',
            'joinedAt',
            'selectedMovies'
          ])
          && request.resource.data.uid == memberUid
          && request.resource.data.selectedMovies is list
          && request.resource.data.selectedMovies.size() == 0
          && getAfter(
            /databases/$(database)/documents/movieGroups/$(groupId)
          ).data.ownerUid == request.auth.uid
          && (memberUid == request.auth.uid
            || areAcceptedFriends(request.auth.uid, memberUid));
        allow update: if request.auth != null
          && request.auth.uid == memberUid
          && resource.data.uid == memberUid
          && request.resource.data.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['selectedMovies'])
          && request.resource.data.selectedMovies is list;
        allow delete: if request.auth != null
          && ((request.auth.uid == memberUid
              && get(
                /databases/$(database)/documents/movieGroups/$(groupId)
              ).data.ownerUid != request.auth.uid)
            || (get(
              /databases/$(database)/documents/movieGroups/$(groupId)
            ).data.ownerUid == request.auth.uid
              && (request.auth.uid != memberUid
                || !existsAfter(
                  /databases/$(database)/documents/movieGroups/$(groupId)
                ))));
      }
    }
  }
}
